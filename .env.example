# PostgreSQL 数据库配置
POSTGRES_USER=sentiment
POSTGRES_PASSWORD=change_me_in_production
POSTGRES_DB=sentiment
PG_PORT=5432
DATABASE_URL=postgresql://sentiment:change_me_in_production@localhost:5432/sentiment

# LLM API 配置（OpenAI 兼容端点）
LLM_BASE_URL=https://api.example.com/v1
LLM_API_KEY=your-api-key-here
LLM_MODEL=deepseek-v4-pro

# DingTalk AI Bitable 配置
DINGTALK_APP_KEY=your-app-key-here
DINGTALK_APP_SECRET=your-app-secret-here
DINGTALK_BASE_ID=your-base-id-here
DINGTALK_SHEET_NAME=your-sheet-name-here
DINGTALK_OPERATOR_ID=your-operator-id-here
